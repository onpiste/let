# Copy to .dev.vars for local development. In production use `wrangler secret put`.

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URIs: http://localhost:5173/auth/callback and
# https://<your-worker>.workers.dev/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@gmail.com
