# Copy to .dev.vars for local development. In production use `wrangler secret put`.

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URIs: http://localhost:5173/auth/callback and
# https://runlet.us/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@gmail.com

# API token with Workers AI access, for the Pi assistant.
CLOUDFLARE_API_KEY=

# Optional: an APNs auth key (.p8 contents) for iOS push notifications. Also
# set APNS_KEY_ID, APNS_TEAM_ID and APNS_TOPIC in wrangler.jsonc. Empty: no push.
APNS_KEY=

# Optional: the VAPID private key for Web Push (`bun run web-push-keys`). The
# public key and WEB_PUSH_SUBJECT are in wrangler.jsonc. Empty: no Web Push.
WEB_PUSH_PRIVATE_KEY=

# Optional: a token for the AI Gateway named by AI_GATEWAY_ID, which stores
# the deployment's Google AI Studio key and carries every Gemini call (web
# search, Deep Research). Empty: those tools only appear for users who add
# their own Google key.
CF_AIG_TOKEN=

# Optional: a shared secret that lets builds and CI post their failures to
# /dev/logs (scripts/devlog). Generate with: openssl rand -hex 32. Empty: the
# route only takes logs from signed-in web and iOS apps.
DEV_LOGS_TOKEN=

# Optional: phone calls through a Twilio number (spike, see
# src/integrations/phone/README.md). All three or none: TWILIO_AUTH_TOKEN is
# the account's auth token, PHONE_ACCOUNT the Google account id (/auth/me)
# whose assistant answers, PHONE_CALLERS comma-separated E.164 numbers.
TWILIO_AUTH_TOKEN=
PHONE_ACCOUNT=
PHONE_CALLERS=
