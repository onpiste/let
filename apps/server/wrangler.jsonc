{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cot-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER" },
  "observability": { "enabled": true },
  // Dynamic Workers: runCode loads each snippet into a fresh isolate.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Knowledge base for the searchKnowledge tool. Create the instance named in
  // src/tools/knowledge.ts (KNOWLEDGE_INSTANCE) in the Cloudflare dashboard first.
  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default", "remote": true }
  ],
  "routes": [{ "pattern": "runlet.us", "custom_domain": true }],
  // The Pi assistant calls Workers AI over REST, so it needs the account id
  // and an API token (set with `wrangler secret put CLOUDFLARE_API_KEY`).
  // TELEGRAM_API_BASE_URL points the bot at a self-hosted Bot API server;
  // empty means https://api.telegram.org.
  // NATIVE_REDIRECT_URI is where native sign-in returns to the iOS app (its
  // URL scheme, see apps/mobile/README.md); empty disables native sign-in.
  // EMAIL_DOMAIN is where each assistant gets its own address; Email Routing
  // must send that domain's mail to this Worker (catch-all rule). Empty
  // turns the email feature off.
  // Usage limits per account ("0" turns one off). Messages count across the
  // Think and Pi assistants; turns on a user's own API key don't count.
  // APNS_* send iOS push notifications: the key id and team id of an APNs
  // auth key (its .p8 goes in the APNS_KEY secret) and the app's bundle id
  // (PRODUCT_BUNDLE_IDENTIFIER in apps/mobile/project.yml). Any of them
  // empty, or no APNS_KEY, turns push off.
  // WEB_PUSH_* send browser push notifications: the VAPID public key (the
  // private one goes in the WEB_PUSH_PRIVATE_KEY secret; make a pair with
  // `bun run web-push-keys` in apps/server) and a contact for push services
  // (mailto: or your https:// origin). Empty turns Web Push off.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "02eec653ae3b648ef566c2469e7fb68e",
    "NATIVE_REDIRECT_URI": "cot://auth/callback",
    "TELEGRAM_API_BASE_URL": "",
    "EMAIL_DOMAIN": "runlet.us",
    "APNS_KEY_ID": "22M6GZS8L8",
    "APNS_TEAM_ID": "F2BGJTV3Y4",
    "APNS_TOPIC": "runlet.GoodMenu",
    "WEB_PUSH_PUBLIC_KEY": "BERuelxoSn0CHSAEGk1YbtzUWTYtnnpzyoldlChIKST-fKHDh8XNXtE-LQsrKxdHiqPlB4dkyqDhkbEjFWopROw",
    "WEB_PUSH_SUBJECT": "https://runlet.us",
    "DAILY_MESSAGE_LIMIT": "500",
    "MINUTE_MESSAGE_LIMIT": "20",
    "MAX_REMINDERS": "50",
    // Web search and Deep Research (Gemini), paid by the deployment. Every
    // call goes through this Cloudflare AI Gateway, which stores the Google
    // AI Studio key; the CF_AIG_TOKEN secret authenticates to it. A user's
    // own Google key, when set, is sent through the gateway instead and
    // isn't limited. Daily limits are per account; "0" turns one off. Deep
    // Research agents are versioned previews; bump GEMINI_RESEARCH_AGENT
    // when Google ships a new one.
    "AI_GATEWAY_ID": "onpiste",
    "DAILY_SEARCH_LIMIT": "100",
    "DAILY_RESEARCH_LIMIT": "3",
    "GEMINI_SEARCH_MODEL": "gemini-flash-latest",
    "GEMINI_RESEARCH_AGENT": "deep-research-preview-04-2026"
  },
  // The client is built by apps/web (its Vite config points the Cloudflare
  // plugin at this file), so there is no assets directory here.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/chat", "/chat/*", "/messengers/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Assistant",
        "name": "Assistant"
      },
      {
        "class_name": "TelegramRoutes",
        "name": "TelegramRoutes"
      },
      {
        "class_name": "EmailAddresses",
        "name": "EmailAddresses"
      },
      {
        "class_name": "Sandbox",
        "name": "SANDBOX"
      }
    ]
  },
  // Each account's sandbox is a Durable Object that starts a container from
  // Cloudflare's managed image (see src/tools/sandbox.ts), so nothing is built here.
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object"
    }
  ],
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_SECRET",
      "ALLOWED_EMAILS",
      "CLOUDFLARE_API_KEY"
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Assistant"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["PiAssistant"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["TelegramRoutes"],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": ["EmailAddresses"],
      "tag": "v5"
    },
    {
      // The Pi chat harness became a headless coding agent (no Durable Object).
      "deleted_classes": ["PiAssistant"],
      "tag": "v6"
    }
  ]
}
