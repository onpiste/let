{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Runtime types (Request, Env, cloudflare:workers, …) come from the
    // workspace's `wrangler types` output (env.d.ts), not a lib or package.
    "lib": ["ES2022"],
    "types": ["node"]
  }
}
