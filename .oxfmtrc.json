{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {
    "internalPattern": ["@cot/"]
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles.css"
  },
  "ignorePatterns": [
    "**/env.d.ts",
    "**/dist/**",
    "**/.wrangler/**",
    "package-lock.json"
  ]
}
