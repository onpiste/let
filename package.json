{
  "name": "cot",
  "version": "1.0.0",
  "private": true,
  "description": "Personal AI assistant built on the Cloudflare Agents SDK",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @cot/web dev",
    "build": "bun run --filter @cot/web build",
    "deploy": "bun run --filter @cot/web deploy",
    "types": "bun run --filter @cot/server types",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "bun run --filter @cot/shared test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "core-js-pure",
    "esbuild",
    "fsevents",
    "sharp",
    "workerd"
  ]
}
