{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cot-assistant",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // The Pi assistant calls Workers AI over REST, so it needs the account id
  // and an API token (set with `wrangler secret put CLOUDFLARE_API_KEY`).
  // TELEGRAM_API_BASE_URL points the bot at a self-hosted Bot API server;
  // empty means https://api.telegram.org.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "02eec653ae3b648ef566c2469e7fb68e",
    "TELEGRAM_API_BASE_URL": ""
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/auth/*",
      "/chat",
      "/chat/*",
      "/pi",
      "/pi/*",
      "/telegram/*",
      "/messengers/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Assistant",
        "name": "Assistant"
      },
      {
        "class_name": "PiAssistant",
        "name": "PiAssistant"
      },
      {
        "class_name": "TelegramLinks",
        "name": "TelegramLinks"
      }
    ]
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_SECRET",
      "ALLOWED_EMAILS",
      "CLOUDFLARE_API_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_BOT_USERNAME",
      "TELEGRAM_WEBHOOK_SECRET_TOKEN"
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Assistant"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["PiAssistant"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["TelegramLinks"],
      "tag": "v3"
    }
  ]
}
